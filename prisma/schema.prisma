generator client {
  provider = "prisma-client"
  output   = "../generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model User {
  id            Int      @id @default(autoincrement())
  email         String   @unique
  full_name     String
  createdAt     DateTime @default(now())
  role          String   @default("USER")
  password_hash String
  devices       Device[]
}

model Device {
  id          Int          @id @default(autoincrement())
  coordLatitude Float
  coordLength Float
  userId      Int
  deployedBy  User         @relation(fields: [userId], references: [id])
  logs        LogMessage[]
}

model LogMessage {
  id       Int    @id @default(autoincrement())
  deviceId Int
  message  String
  deviceIn Device @relation(fields: [deviceId], references: [id])
}
